#!/bin/bash

source "${CI_PROJECT_DIR}"/cicd/before-script

declare LOCAL_DIR="/mnt/shared/local/${STACK_NAME}"
declare LIVE_DIR="${LOCAL_DIR}/live"
# shellcheck disable=SC2155
declare TIMESTAMP=$( date +%Y%m%d%H%M%S )

# TODO refactor to link all EXCEPT for those listed here (config.ini and folio.ini)
declare -a LINK_CONFIGS=("RecordDataFormatter.ini")

add_config_symlinks() {
    declare conf
    for conf in "${LINK_CONFIGS[@]}"; do
        run_on_node "1" "pc-symlink \"$STACK_NAME\" -vv -f \
            -t \"${LOCAL_DIR}/repo/vufind/local/config/vufind/${conf}\" \
            -s \"${LOCAL_DIR}/live/local/config/vufind/${conf}\""
    done
}

main() {
    if [[ $STACK_NAME == devel-* ]]; then
        install_yq

        echo "Getting compose file from ${COMPOSE_PATH}"
        scp deploy@"${DEPLOY_HOST_1}":"${COMPOSE_PATH}"/docker-compose.catalog.yml docker-compose.catalog.yml

        # Mount host live/ dir for /usr/local/vufind/
        ./yq -i ".services.catalog.volumes += \"/mnt/shared/local/${STACK_NAME}/live/:/usr/local/vufind/\"" docker-compose.catalog.yml;
        ./yq -i "del(.services.catalog.volumes[] | select(. ==  \"/mnt/shared/local/${STACK_NAME}/repo/vufind/module/Catalog/:/usr/local/vufind/module/Catalog\"))" docker-compose.catalog.yml;
        ./yq -i "del(.services.catalog.volumes[] | select(. ==  \"/mnt/shared/local/${STACK_NAME}/repo/vufind/themes/msul/:/usr/local/vufind/themes/msul\"))" docker-compose.catalog.yml;

        # Copy the updated compose files to the server
        echo "Copying updated compose file to ${COMPOSE_PATH}"
        scp docker-compose.catalog.yml deploy@"${DEPLOY_HOST_1}":"${COMPOSE_PATH}"/;

        remove_bind_mount "${STACK_NAME}" "$LIVE_DIR/module/Catalog"
        remove_bind_mount "${STACK_NAME}" "$LIVE_DIR/themes/msul"

        # Sleeping for 2 hours; if setup is cancelled somehow, the container will eventually terminate
        TEMP_CTR_ID=$( run_on_node "1" "docker run -d --rm --env-file <( sed -e 's/^export //' -e 's/^\\(.*\\)=\"\\(.*\\)\"$/\1=\2/' ${COMPOSE_PATH}/.env ) -v \"$LIVE_DIR\":/media/live -v \"$LOCAL_DIR\":/media/local --name \"temp-${STACK_NAME}-$TIMESTAMP\" \"$CI_REGISTRY_IMAGE/vufind:${CI_COMMIT_SHORT_SHA}${EXTRA_TAG_SUFFIX}\" sleep 7200" )
        sleep 2
        run_on_node "1" "pc-install $STACK_NAME -v -o 1000 -g 1000 -m g+ws -d -t \"$LIVE_DIR\""
        run_on_node "1" "docker exec \"$TEMP_CTR_ID\" rsync -a /usr/local/vufind/ /media/live/"

        if [[ ${VUFIND_CORE_INSTALLATION} -ne 1 ]]; then
            add_bind_mount "${STACK_NAME}" "${LOCAL_DIR}/repo/vufind/module/Catalog" "${LIVE_DIR}/module/Catalog"
            add_bind_mount "${STACK_NAME}" "${LOCAL_DIR}/repo/vufind/themes/msul" "${LIVE_DIR}/themes/msul"
            add_config_symlinks

            # Sync back the vendor dir again since the bind mount would have removed it (TODO is there a better way to do this?)
            run_on_node "1" "docker exec \"$TEMP_CTR_ID\" rsync -a /usr/local/vufind/themes/msul/vendor/ /media/local/repo/vufind/themes/msul/vendor/"
        fi

        run_on_node "1" "docker rm -f \"$TEMP_CTR_ID\""

        run_on_node 1 "docker stack deploy --with-registry-auth -c <(source ${COMPOSE_PATH}/.env; envsubst <${COMPOSE_PATH}/docker-compose.catalog.yml) ${STACK_NAME}-catalog";
    fi
}

before_script
main
