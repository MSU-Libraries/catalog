<?php
/** MSU - Except marked part, all code has been modified by MSU */
/** MSU START */
use Catalog\Holdings\GetThisLoader;

$selected = '';
$selectedScore = -1;
/** @var Catalog\View\Helper\Root\Record $record */
$record = $this->record($this->driver);
foreach ($this->statusItems as $item) {
  $record->updateAvailabilityStatus($item);
  $itemLocation = $item['location'];
  if ($item['availability']->isAvailable()) {
    $score = 4;
  } elseif ($item['status'] == 'Restricted') { // displayed as "Library Use Only"
    $score = 2;
  } else {
    $score = 0;
  }
  if ($itemLocation != 'MSU Remote Storage') {
    $score += 1;
  }
  if ($score > $selectedScore) {
    $selected = $item;
    $selectedScore = $score;
  }
  if ($selected != '') {
    $location = $selected['location'];
    $callnumber = $selected['callnumber'];
    $callNumPrefix = !empty($selected['callnumber_prefix']) ? $selected['callnumber_prefix'] . ' ' : '';
  }
}
/** MSU END */
?>
<?php if ($selected != ''): ?>
  <?php $id = $selected['id']; ?>
  <?php $item_id = $selected['item_id']; ?>
  <?php $getthis = new GetThisLoader($this->driver, $record, $this->statusItems, $item_id); ?>
  <tr>
    <th>Status</th>
    <td class="fullAvailability">
      <?php /** @var $availabilityStatus VuFind\ILS\Logic\AvailabilityStatus */ ?>
      <?php $availabilityStatus = $selected['availability']; ?>
      <?php /** NOT MSU START */ ?>
      <?php
        $statusClass = $this->availabilityStatus()->getClass($availabilityStatus);
        if ($availabilityStatus->isAvailable() && $item['reserve'] === 'Y') {
          $statusDescription = 'On Reserve';
        } else {
          $statusDescription = $availabilityStatus->getStatusDescription();
        }
        /** NOT MSU END */
      ?>
      <strong class="<?=$this->escapeHtmlAttr($statusClass)?>"><?=$this->escapeHtml($statusDescription)?></strong>
      <?php if ($getthis && ! str_starts_with($id, 'hlm.') && ! $getthis->isOnlineResource()): ?>
        <a class="pl-1 placehold" data-lightbox href="<?= $this->escapeHtmlAttr("/Record/$id/GetThis?item_id=$item_id") ?>" rel="nofollow">
          <?=$this->icon('book', 'icon-link__icon') ?>
          <?=$this->transEsc('Get this')?>
        </a>
      <?php endif; ?>
    </td>
  </tr>
  <?php if ($location != ''): ?>
    <tr>
      <th>Location</th>
      <td class="fullLocation">
        <?php $locationText = $this->transEsc($location); ?>
        <?php if (count($this->statusItems) > 1): ?>
          <?=$locationText?>&nbsp;&nbsp;<a href="<?=$this->escapeHtmlAttr($this->recordLinker()->getUrl($selected['id']))?>/Holdings#tabnav" target="_blank">more holdings</a>
        <?php else: ?>
          <?=$locationText?>
        <?php endif; ?>
        <?php if ($getthis && ! str_starts_with($id, 'hlm.') && ! $getthis->isOnlineResource()): ?>
          <a class="pl-1 placehold" data-lightbox href="<?= $this->escapeHtmlAttr("/Record/$id/MapThis?item_id=$item_id") ?>" rel="nofollow">
            <?=$this->icon('format-map', 'icon-link__icon') ?>
            <?=$this->transEsc('Map this')?>
          </a>
        <?php endif; ?>
      </td>
    </tr>
  <?php endif; ?>
  <?php if ($callnumber != ''): ?>
    <tr>
      <th>Call Number</th>
      <td class="fullCallnumber">
        <?=$this->escapeHtml($callNumPrefix)?><?=$this->escapeHtml($callnumber)?>
      </td>
    </tr>
  <?php endif; ?>
  <?php if (!empty($selected)): ?>
    <?= $this->locationNotices($selected) ?>
  <?php endif; ?>
  <?php foreach ($this->holdingsTextFieldNames as $holdingsTextField): ?>
    <?php if (!empty($item[$holdingsTextField])): ?>
      <tr class="statusItemsHoldingsTextFields">
        <th><?= $this->transEsc(ucfirst($holdingsTextField)) ?>: </th>
        <td><?= $this->escapeHtml(implode('; ', ((array)$item[$holdingsTextField]))); ?></td>
      </tr>
    <?php endif; ?>
  <?php endforeach; ?>
<?php else: ?>
  <tr class="fullAvailability"><th class="text-danger">Unavailable</th><td></td></tr>
<?php endif; ?>
