<?php
  $item = $this->getThisLoader->getItem();
  if (empty($item)) {
    return;
  }
  $check = $item['check'] ?? false;
  $link = $this->getThisLoader->getLink();
  $dataLightbox = !empty($item['linkLightbox']) ? 'data-lightbox' : '';

  $notices = $this->notices()->getManager()->getActiveList('request');

  // PC-745 Disabled requests during configured periods of time
  if (!empty($notices)) {
    $class = ' disabled';
    $unavailable = '(UNAVAILABLE)';
    $attributes = 'aria-disabled="true"';
  } else {
    $class = '';
    $unavailable = '';
    $attributes = 'href="' . $this->escapeHtmlAttr($this->recordLinker()->getRequestUrl($link)) . '"';
  }
?>
<?php if (($item['is_holdable'] ?? false) && !empty($link)) : ?>
  <div>
    <p>
      <strong><a href='https://lib.msu.edu/circ/borrowing-at-msu' target='_blank'>On-Campus Pickup</a>:</strong>
      <?= $this->transEsc('campus_pickup_place_request_text') ?>
    </p>
    <ul>
      <li>
        <a
          class="<?=$check ? 'checkRequest ' : ''?>placehold<?= $class ?>"
          <?= $dataLightbox ?>
          <?= $attributes ?>
        >
          <?= $this->transEsc($check ? 'Check Hold' : 'campus_pickup_place_request') . $unavailable ?>
        </a>
      </li>
    </ul>
  </div>
<?php endif ?>
